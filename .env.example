# ============================================================
# Vanguard-GWM Environment Configuration
# ============================================================

# Application
APP_NAME=Vanguard-GWM
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/vanguard_gwm

# Vanguard Model
MODEL_LATENT_DIM=64
FORECAST_HORIZON=5
DEFENSIVE_THRESHOLD=0.60

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_PORT=8501